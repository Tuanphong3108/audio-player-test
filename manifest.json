{
  "name": "Media Player",
  "short_name": "Media Player",
  "id": "/audio-player-test/",
  "start_url": "/audio-player-test/index.html",
  "scope": "/audio-player-test/",
  "display": "standalone",
  "background_color": "#1C1B1F",
  "theme_color": "#D0BCFF",
  "description": "Material Design 3 Expressive Media Player with Real-time Visuals",
  "icons": [
    {
      "src": "/audio-player-test/music_note.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/audio-player-test/music_note.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/audio-player-test/music_note.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/audio-player-test/index.html",
      "accept": {
        "audio/*": [
          ".mp3",
          ".wav",
          ".ogg",
          ".m4a",
          ".flac"
        ],
        "text/plain": [
          ".lrc"
        ],
        "video/*": [
          ".mp4",
          ".m4v",
          ".webm",
          ".mkv",
          ".mov",
          ".ogv"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}